    { "id": "r-sys-regex", "priority": 1000, "is_system": true, "match_type": "Regex", "value": "\\bnetflix\\b", "category": { "builtin": "ENTERTAINMENT" } },
    { "id": "r-amt", "priority": 1100, "is_system": true, "match_type": "AmountRange", "value": "40000,60000", "category": { "builtin": "RENT_EMI" } }
  ],
